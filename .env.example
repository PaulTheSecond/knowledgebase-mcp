# Окружение knowledgebase-mcp
REPOS_DIR=C:\Repos
DB_PATH=data/knowledge.db

# Авторизация в Web Dashboard (Basic Auth: admin / DASHBOARD_PASSWORD)
DASHBOARD_PASSWORD=change_me_to_strong_password

# Секрет для верификации HMAC-SHA256 подписей входящих вебхуков (GitHub/Gitea/GitLab)
WEBHOOK_SECRET=change_me_to_strong_webhook_secret

# GitHub Personal Access Token для клонирования и обновления приватных репозиториев
GITHUB_PAT=ghp_your_github_token_here

# Настройки LLM для RAG-чата (OmniRoute / vLLM / Ollama / OpenAI-совместимый эндпоинт)
LLM_BASE_URL=http://localhost:8005/v1
LLM_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
