# ==============================================================================
# Пример конфигурации Knowledge MCP & Web Dashboard (.env.example)
# ==============================================================================

# 1. Пути к данным и конфигурации
# База данных SQLite (на хосте: data/knowledge.db; в Docker: /data/knowledge.db)
DB_PATH=data/knowledge.db
CONFIG_PATH=data/config.yaml
REPOS_DIR=C:\Repos
CLONES_DIR=data/clones

# 2. Авторизация и безопасность панели управления (http://localhost:8000)
# Учетные данные Basic Auth: логин admin / пароль DASHBOARD_PASSWORD
DASHBOARD_PASSWORD=change_me_to_strong_password
DAEMON_SECRET_KEY=change_me_to_random_secret_token_32_bytes
DAEMON_URL=http://127.0.0.1:8000

# 3. Интеграция с Git-провайдерами и вебхуками
# Секрет для верификации HMAC-SHA256 подписей входящих вебхуков (GitHub/Gitea/GitLab)
WEBHOOK_SECRET=change_me_to_strong_webhook_secret
# GitHub Personal Access Token (для клонирования приватных репозиториев)
GITHUB_PAT=ghp_your_github_token_here

# 4. Настройки нейросетевого шлюза (LLM / RAG Chat)
# Адрес OpenAI-совместимого API (Kiro / OmniRoute / vLLM / Ollama / OpenAI)
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=kr/claude-sonnet-4.5
LLM_API_KEY=sk-your-llm-api-key-here

# 5. Векторные эмбеддинги (SentenceTransformers)
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
